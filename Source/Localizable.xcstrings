    "Send up to three birds to the island. Open their exit lane, then tap To bank to deliver them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل ما يصل إلى ثلاث دجاجات إلى الجزيرة. افتح مسار خروجها ثم اضغط «إلى جانب الطريق» لتكمل عبورها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবারে তিনটি পর্যন্ত মুরগি মাঝের আশ্রয়ে পাঠান। বেরোনোর লেন খুলে ‘রাস্তার প্রান্তে’ চাপলে ওরা পার হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send up to three birds to the island. Open their exit lane, then tap To bank to deliver them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Send up to three birds to the island. Open their exit lane, then tap To bank to deliver them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Send up to three birds to the island. Open their exit lane, then tap To bank to deliver them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多送三隻雞到安全島。開放出口車道，再點「前往路邊」送牠們抵達。"
          }
        }
      }
    },
    "Set the waiting flock’s lane to birds, then send it to the island.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط إشارة المسار الذي ينتظر عنده السرب على «الدجاج»، ثم أرسله إلى الجزيرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপেক্ষারত দলটির লেন মুরগির জন্য খুলে ওদের মাঝের আশ্রয়ে পাঠান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the waiting flock’s lane to birds, then send it to the island."
          }
        },
        "en-GB": {
