    "Tap Birds to let cars pass. Long queues can block the neighbouring lane.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «الدجاج» لتسمح للسيارات بالمرور. قد يسد الطابور الطويل المسار المجاور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাড়ি যেতে দিতে ‘মুরগি’ চাপুন। লম্বা সারি পাশের লেন আটকে দিতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Birds to let cars pass. Long queues can block the neighbouring lane."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Birds to let cars pass. Long queues can block the neighbouring lane."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Birds to let cars pass. Long queues can block the neighboring lane."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「雞群」改讓車輛通行。車隊太長時可能堵住相鄰車道。"
          }
        }
      }
    },
    "Tap Traffic to give birds the signal. A vehicle already moving must clear first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «المركبات» لتسمح للدجاج بالعبور. انتظر حتى تخرج أي مركبة بدأت بالمرور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুরগিকে যাওয়ার সিগন্যাল দিতে ‘যানবাহন’ চাপুন। কোনো গাড়ি চলতে শুরু করলে আগে সেটিকে পার হতে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Traffic to give birds the signal. A vehicle already moving must clear first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Traffic to give birds the signal. A vehicle already moving must clear first."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Traffic to give birds the signal. A vehicle already moving must clear first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「車流」讓雞群通行。正在行駛的車輛必須先通過。"
          }
        }
      }
    },
