    "Deliver every flock before time runs out. Shorter waits for birds and traffic earn more stars.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوصل كل الأسراب قبل انتهاء الوقت. قلّل انتظار الدجاج والمركبات لتحصل على نجوم أكثر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় ফুরোনোর আগে সব দল পার করান। মুরগি আর যানবাহনের অপেক্ষা কমলে বেশি তারা পাবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliver every flock before time runs out. Shorter waits for birds and traffic earn more stars."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliver every flock before time runs out. Shorter waits for birds and traffic earn more stars."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliver every flock before time runs out. Shorter waits for birds and traffic earn more stars."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在時間結束前送達所有雞群。雞群與車輛等得越短，星星就越多。"
          }
        }
      }
    },
